import { StandardListView } from "std-widgets.slint";
import { TabButton } from "./components/buttons.slint";
import { ArchiveTab } from "./tabs/archive_tab.slint";
import { TexturesTab } from "./tabs/textures_tab.slint";
import { XmlTab } from "./tabs/xml_tab.slint";
import { LogTab } from "./tabs/log_tab.slint";

export component AppWindow inherits Window {
    title: "D2DC Tool v2.0 - Divinity 2 Modding Studio";
    min-width: 1040px;
    min-height: 720px;
    preferred-width: 1100px;
    preferred-height: 760px;
    background: #141414;

    in-out property <int> active_tab: 0;
    in-out property <string> log_text: "System Ready.\n";
    in-out property <string> status_msg: "Ready.";

    // Archive Tab State
    in-out property <[StandardListViewItem]> archive_files: [];

    // Textures Tab State
    in-out property <image> preview_texture;
    in-out property <string> preview_info: "Select a DDS to preview.";

    // XML Tab State
    in-out property <string> xml_preview_content: "";

    // Global File Dialog Callbacks
    callback browse_file(string) -> string;
    callback browse_folder() -> string;
    callback save_file(string) -> string;

    // Archive Callbacks
    callback unpack_dv2(string, string);
    callback batch_unpack_dv2(string);
    callback pack_dv2(string, string, bool, string, int);
    callback batch_pack_dv2(string, bool, string, int);
    callback load_dv2_tree(string);
    callback archive_item_clicked(int);

    // Textures Callbacks
    callback request_texture_preview(string);
    callback repair_dds_file(string);
    callback batch_repair_dds(string);
    callback convert_dds_to_nif(string, string);
    callback extract_nif_to_dds(string, string);
    callback batch_dds_to_nif(string);
    callback batch_nif_to_dds(string);

    // XML & Diff Callbacks
    callback create_diff_patch(string, string, string);
    callback apply_diff_patch(string, string);
    callback extract_binary_xml(string, string);
    callback repack_readable_xml(string, string, string);
    callback batch_extract_xml(string);
    callback batch_repack_xml(string);
    callback scan_hashes(string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // TOP NAVIGATION TABS
        HorizontalLayout {
            spacing: 6px;
            height: 32px;

            TabButton {
                text: "DV2 Archive";
                active: root.active_tab == 0;
                accent-color: #3e6a90;
                clicked => { root.active_tab = 0; }
            }

            TabButton {
                text: "Textures & DDS";
                active: root.active_tab == 1;
                accent-color: #f0b132;
                clicked => { root.active_tab = 1; }
            }

            TabButton {
                text: "XML & Diff Modding";
                active: root.active_tab == 2;
                accent-color: #23a55a;
                clicked => { root.active_tab = 2; }
            }

            TabButton {
                text: "Terminal Log";
                active: root.active_tab == 3;
                accent-color: #e59535;
                clicked => { root.active_tab = 3; }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        // VIEWPORT AREA
        Rectangle {
            vertical-stretch: 1;

            if root.active_tab == 0: ArchiveTab {
                archive_files: root.archive_files;

                browse_file(ext) => { root.browse_file(ext) }
                browse_folder => { root.browse_folder() }
                save_file(ext) => { root.save_file(ext) }
                unpack_dv2(i, o) => { root.unpack_dv2(i, o) }
                batch_unpack_dv2(f) => { root.batch_unpack_dv2(f) }
                pack_dv2(s, o, c, a, l) => { root.pack_dv2(s, o, c, a, l) }
                batch_pack_dv2(f, c, a, l) => { root.batch_pack_dv2(f, c, a, l) }
                load_dv2_tree(p) => { root.load_dv2_tree(p) }
                archive_item_clicked(idx) => { root.archive_item_clicked(idx) }
            }

            if root.active_tab == 1: TexturesTab {
                preview_texture <=> root.preview_texture;
                preview_info <=> root.preview_info;

                browse_file(ext) => { root.browse_file(ext) }
                browse_folder => { root.browse_folder() }
                save_file(ext) => { root.save_file(ext) }
                convert_dds_to_nif(d, n) => { root.convert_dds_to_nif(d, n) }
                extract_nif_to_dds(n, d) => { root.extract_nif_to_dds(n, d) }
                batch_dds_to_nif(f) => { root.batch_dds_to_nif(f) }
                batch_nif_to_dds(f) => { root.batch_nif_to_dds(f) }
                request_texture_preview(p) => { root.request_texture_preview(p) }
                repair_dds_file(p) => { root.repair_dds_file(p) }
                batch_repair_dds(p) => { root.batch_repair_dds(p) }
            }

            if root.active_tab == 2: XmlTab {
                xml_preview_content <=> root.xml_preview_content;

                browse_file(ext) => { root.browse_file(ext) }
                browse_folder => { root.browse_folder() }
                save_file(ext) => { root.save_file(ext) }
                extract_binary_xml(b, t) => { root.extract_binary_xml(b, t) }
                repack_readable_xml(o, t, out) => { root.repack_readable_xml(o, t, out) }
                batch_extract_xml(f) => { root.batch_extract_xml(f) }
                batch_repack_xml(f) => { root.batch_repack_xml(f) }
                scan_hashes(f) => { root.scan_hashes(f) }
                create_diff_patch(b, m, p) => { root.create_diff_patch(b, m, p) }
                apply_diff_patch(t, p) => { root.apply_diff_patch(t, p) }
            }

            if root.active_tab == 3: LogTab {
                log_text: root.log_text;
            }
        }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 30px;
            background: #2b2d31;
            border-radius: 4px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.status_msg;
                    color: #4CAF50;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
